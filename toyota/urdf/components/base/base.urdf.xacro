<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:property name="base_length" value="2"/>
    <xacro:property name="base_thickness" value="1"/>
    <xacro:property name="base_height" value="0.7"/>
    <xacro:property name="clearance" value="0.45"/>

    <xacro:macro name="base">
        <link name="base_footprint"/>

        <link name="base_link">

            <!-- <visual>
                <origin xyz="0 0 0" rpy="0.0 0.0 0.0" />
                <geometry>
                    <box size="${base_length} ${base_thickness} ${base_height}"/>
                </geometry>
            </visual> -->

            <visual>
                <origin xyz="0 0 -0.5" rpy="${pi/2} 0 ${3*pi/2}"/>
                <geometry>
                    <mesh filename="file://$(find toyota)/meshes/base/Porsche_body_1.glb"/>
                </geometry>
            </visual>


            <collision>
                <origin xyz="0 0 0" rpy="0.0 0.0 0.0" />
                <geometry>
                    <box size="${base_length} ${base_thickness} ${base_height}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mass value="5.0"/>
                <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
            </inertial>
        </link>

        <joint name="base_link_joint" type="fixed">
            <origin xyz="0.0 0.0 ${clearance}" rpy="0.0 0.0 0.0"/>
            <parent link="base_footprint"/>
            <child link="base_link"/>
        </joint>

    </xacro:macro>
</robot>