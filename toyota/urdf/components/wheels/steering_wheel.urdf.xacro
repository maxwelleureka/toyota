<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">


    <xacro:property name="wheel_radius" value="0.3"/>
    <xacro:property name="wheel_length" value="0.1"/>
    <xacro:property name="wheel_mass" value="3.0"/>
    <xacro:property name="steering_limit" value="0.6"/>

    <xacro:macro name="steering_wheel" params="prefix parent reflection:=1 *origin">

        <joint name="${prefix}_steering_joint" type="revolute">
            <parent link="${parent}"/>
            <child link="${prefix}_steering_link"/>
            <axis xyz="0 0 1"/>
            <dynamics damping="0.2"/>
            <xacro:insert_block name="origin"/>
            <limit lower="${-steering_limit}" upper="${steering_limit}" effort="100" velocity="1.0"/>
        </joint>

        <link name="${prefix}_steering_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.02" length="0.05"/>
                </geometry>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.02" length="0.05"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="${wheel_mass}"/>
                <inertia ixx="${(3*wheel_radius**2+wheel_length**2)*wheel_mass*1/12}" ixy="0.0" ixz="0.0"
                        iyy="${(3*wheel_radius**2+wheel_length**2)*wheel_mass*1/12}" iyz="0.0"
                        izz="${(wheel_mass*wheel_radius**2)*1/2}"/>
            </inertial>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="${prefix}_steering_link"/>
            <child link="${prefix}_wheel_link"/>
            <origin xyz="0 0 ${-wheel_radius}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit effort="100" velocity="10.0"/>
        </joint>

        <link name="${prefix}_wheel_link">
            <!-- <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
            </visual> -->

            <visual>
                <origin xyz="0 0 0" rpy="0 0 ${reflection * pi/2}"/>
                <geometry>
                    <mesh filename="file://$(find toyota)/meshes/wheels/Porsche_wheel_1.glb"/>
                </geometry>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
            </collision>
            
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="${wheel_mass}"/>
                <inertia ixx="${(3*wheel_radius**2+wheel_length**2)*wheel_mass*1/12}" ixy="0.0" ixz="0.0"
                        iyy="${(3*wheel_radius**2+wheel_length**2)*wheel_mass*1/12}" iyz="0.0"
                        izz="${(wheel_mass*wheel_radius**2)*1/2}"/>
            </inertial>
        </link>

        

    </xacro:macro>
</robot>